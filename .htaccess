Options -Indexes
RedirectMatch 403 ^/\.data(?:/|$)
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L,NC]
RewriteRule ^(?:data|docs|scripts|outputs)(?:/|$) - [F,L,NC]
RewriteRule ^\.data(?:/|$) - [F,L,NC]
RewriteRule ^api/(auth|data)$ api.php [L,QSA]
</IfModule>
<FilesMatch "(?i)^(?:\.env.*|auth-mail\.php|.*\.(?:(?:sqlite3?|db)(?:-(?:wal|shm))?|key|py|toml|zip))$">
Require all denied
</FilesMatch>
<IfModule mod_headers.c>
Header always set Referrer-Policy "no-referrer"
Header always set X-Frame-Options "DENY"
Header always set X-Content-Type-Options "nosniff"
<Files "auth.html">
Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
</Files>
</IfModule>
